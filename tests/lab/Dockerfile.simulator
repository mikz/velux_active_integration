ARG PYTHON_BASE
FROM ${PYTHON_BASE}
RUN apt-get update && apt-get install -y --no-install-recommends iproute2 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir aiohttp==3.14.3
WORKDIR /app
COPY tests/__init__.py /app/tests/__init__.py
COPY tests/lab/__init__.py tests/lab/cloud.py /app/tests/lab/
COPY tests/lab/gate.py /lab/gate.py
COPY .lab/tls /tls
ENV PYTHONUNBUFFERED=1
